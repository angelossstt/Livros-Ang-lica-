<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Livros & Co.</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f4f4f4;
    }
    header {
      background-color: #4a2c91;
      color: white;
      padding: 1rem;
      text-align: center;
    }
    .produtos {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1rem;
      padding: 2rem;
    }
    .produto {
      background: white;
      border-radius: 8px;
      padding: 1rem;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      text-align: center;
    }
    .produto img {
      max-width: 100%;
      height: auto;
      border-radius: 4px;
    }
    .produto h3 {
      margin: 0.5rem 0;
    }
    .whatsapp {
      background-color: #25D366;
      color: white;
      padding: 0.5rem 1rem;
      border: none;
      border-radius: 4px;
      text-decoration: none;
      display: inline-block;
      margin-top: 0.5rem;
    }
    footer {
      text-align: center;
      padding: 1rem;
      background-color: #ddd;
    }
  </style>
</head>
<body>
  <header>
    <h1>Livros & Co.</h1>
    <p>Conhecimento ao seu alcance</p>
  </header>

  <section class="produtos">
    <div class="produto">
      <img src="https://via.placeholder.com/200x300" alt="Livro 1">
      <h3>Livro Exemplo 1</h3>
      <p>Descrição curta do livro 1.</p>
      <a class="whatsapp" href="https://wa.me/5511999999999?text=Olá! Tenho interesse no Livro Exemplo 1">Comprar no WhatsApp</a>
    </div>

    <div class="produto">
      <img src="https://via.placeholder.com/200x300" alt="Livro 2">
      <h3>Livro Exemplo 2</h3>
      <p>Descrição curta do livro 2.</p>
      <a class="whatsapp" href="https://wa.me/5511999999999?text=Olá! Tenho interesse no Livro Exemplo 2">Comprar no WhatsApp</a>
    </div>
  </section>

  <footer>
    <p>&copy; 2025 Livros & Co. | contato@livroseco.com</p>
  </footer>
</body>
</html>